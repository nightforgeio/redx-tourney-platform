{
  "name": "redx-tourney-platform",
  "version": "0.1.0",
  "description": "RedX Gamerz — Free Fire tournament management platform (player + admin + wallet + redeem)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings --watch src/server.js",
